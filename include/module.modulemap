module SMB2 [system] [extern_c] {
    module LibSMB2 {
        header "apple/config.h"
        header "smb2/smb2-errors.h"
        header "smb2/smb2.h"
        header "smb2/libsmb2.h"
        // libsmb2 exposes share enumeration, not the separate libdcerpc API.
        // Importing full DCE/RPC headers here bypasses the internal prefix macros.
        header "smb2/libsmb2-share-enum.h"
    }
    
    module Internal {
        header "libsmb2-private.h"
    }
    
    explicit module Raw {
        header "smb2/libsmb2-raw.h"
    }
    
    export SMB2
}
